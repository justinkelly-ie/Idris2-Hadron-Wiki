package Idris2-Hadron-Wiki
version = 0.1.0
authors = "Justin Kelly"
brief   = "Executable Verification Wiki & ScaleTransform Specs for Idris2-Hadron"

depends = base
        , idris2-QuickCheck
        , Idris2-Multiset-Core
        , Idris2-Multiset-Transform
        , Idris2-Geometry
        , Idris2-Physics
        , Idris2-Hadron

sourcedir = "Library"

modules = Wiki.Generators
        , Wiki.HadronScaleTransformSpec
        , Wiki.Observations.HadronicConfinement
        , Wiki.Observations.StandardModel
        , Wiki.Observations.QuarkHadronAlgebra
        , Wiki.Observations.MesonAlgebra
        , Wiki.Observations.HeavyMesonAlgebra
        , Wiki.Observations.HyperonAlgebra
        , Wiki.Observations.ExoticMultiquark
        , Wiki.Observations.ParticleScattering
        , Wiki.Observations.HadronizationEngine
        , Wiki.Observations.TypeIndexedMultiset
        , Wiki.Observations.GaugeBosons
        , Wiki.Observations.StellarNuclei
        , Wiki.Observations.StellarNucleosynthesis
        , Wiki.Observations.CosmicNucleosynthesis
        , Wiki.Observations.PlasmaRecombination
        , Wiki.Observations.AlphaReplication
        , Wiki.Main

main = Wiki.Main
executable = lhadron-wiki
